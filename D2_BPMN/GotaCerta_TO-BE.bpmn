<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_tobe" targetNamespace="http://fiap.com.br/gs2026/gotacerta" exporter="Equipe Gota Zero" exporterVersion="1.0">
  <bpmn:collaboration id="C_tobe">
    <bpmn:participant id="Pool_tobe" name="TO-BE: o GotaCerta avisa o vazamento em dias" processRef="P_tobe" />
  </bpmn:collaboration>
  <bpmn:process id="P_tobe" name="TO-BE: o GotaCerta avisa o vazamento em dias" isExecutable="false">
    <bpmn:laneSet id="LS_tobe">
      <bpmn:lane id="L_fam2" name="Família (cliente)">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_gota" name="GotaCerta (sistema com IA)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ana" name="Analista da Sabesp">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Nova leitura do hidrômetro (a cada hora)">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Receber a leitura sem nome e CPF">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_DO_base">
        <bpmn:targetRef>DO_base</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T2" name="Comparar com o padrão da casa (IA)">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Consumo fora do padrão?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Leitura registrada">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T3" name="Calcular a causa provável e a confiança">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Confiança alta?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T4" name="Enviar alerta pelo app e pelo WhatsApp">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T5" name="Revisar o caso">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_DO_alerta">
        <bpmn:targetRef>DO_alerta</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="T6" name="Ver o diagnóstico e fazer o teste guiado">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="Achou o problema?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T7" name="Consertar ou chamar um encanador">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="T8" name="Confirmar que o consumo voltou ao normal">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E2" name="Vazamento resolvido">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T9" name="Analisar e agendar visita técnica">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E3" name="Visita agendada">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DO_base" name="Base de leituras pseudonimizada" dataObjectRef="DO_DO_base" />
    <bpmn:dataObject id="DO_DO_base" />
    <bpmn:dataObjectReference id="DO_alerta" name="Alerta (ABERTO / EM_ANALISE / RESOLVIDO)" dataObjectRef="DO_DO_alerta" />
    <bpmn:dataObject id="DO_DO_alerta" />
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" name="" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="F4" name="Não" sourceRef="G1" targetRef="E1" />
    <bpmn:sequenceFlow id="F5" name="Sim" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F6" name="" sourceRef="T3" targetRef="G2" />
    <bpmn:sequenceFlow id="F7" name="Sim" sourceRef="G2" targetRef="T4" />
    <bpmn:sequenceFlow id="F8" name="Não" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F9" name="" sourceRef="T5" targetRef="T4" />
    <bpmn:sequenceFlow id="F10" name="" sourceRef="T4" targetRef="T6" />
    <bpmn:sequenceFlow id="F11" name="" sourceRef="T6" targetRef="G3" />
    <bpmn:sequenceFlow id="F12" name="Sim" sourceRef="G3" targetRef="T7" />
    <bpmn:sequenceFlow id="F13" name="" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F14" name="" sourceRef="T8" targetRef="E2" />
    <bpmn:sequenceFlow id="F15" name="Não (pede ajuda)" sourceRef="G3" targetRef="T9" />
    <bpmn:sequenceFlow id="F16" name="" sourceRef="T9" targetRef="E3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_tobe" name="TO-BE - com o GotaCerta">
    <bpmndi:BPMNPlane id="PL_tobe" bpmnElement="C_tobe">
      <bpmndi:BPMNShape id="Pool_tobe_di" bpmnElement="Pool_tobe" isHorizontal="true"><dc:Bounds x="40" y="40" width="1800" height="620" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_fam2_di" bpmnElement="L_fam2" isHorizontal="true"><dc:Bounds x="70" y="40" width="1770" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_gota_di" bpmnElement="L_gota" isHorizontal="true"><dc:Bounds x="70" y="240" width="1770" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_ana_di" bpmnElement="L_ana" isHorizontal="true"><dc:Bounds x="70" y="480" width="1770" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="112" y="332" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="70" y="374" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="195" y="310" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="365" y="310" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="545" y="325" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="510" y="296" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="552" y="412" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="596" y="418" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="640" y="310" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="825" y="325" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="790" y="296" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="920" y="310" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="790" y="530" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="1075" y="100" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G3_di" bpmnElement="G3" isMarkerVisible="true"><dc:Bounds x="1275" y="115" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1240" y="86" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T7_di" bpmnElement="T7"><dc:Bounds x="1380" y="100" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T8_di" bpmnElement="T8"><dc:Bounds x="1545" y="310" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="1752" y="332" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1710" y="374" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T9_di" bpmnElement="T9"><dc:Bounds x="1225" y="530" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E3_di" bpmnElement="E3"><dc:Bounds x="1442" y="552" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1400" y="594" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_base_di" bpmnElement="DO_base"><dc:Bounds x="242" y="400" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="200" y="452" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_alerta_di" bpmnElement="DO_alerta"><dc:Bounds x="1022" y="560" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="980" y="612" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="148" y="350" /><di:waypoint x="195" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="325" y="350" /><di:waypoint x="365" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="495" y="350" /><di:waypoint x="545" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="570" y="375" /><di:waypoint x="570" y="412" /><bpmndi:BPMNLabel><dc:Bounds x="576" y="384" width="30" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="595" y="350" /><di:waypoint x="640" y="350" /><bpmndi:BPMNLabel><dc:Bounds x="600" y="330" width="30" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="780" y="350" /><di:waypoint x="825" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="875" y="350" /><di:waypoint x="920" y="350" /><bpmndi:BPMNLabel><dc:Bounds x="880" y="330" width="30" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="850" y="375" /><di:waypoint x="850" y="530" /><bpmndi:BPMNLabel><dc:Bounds x="856" y="490" width="30" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="910" y="570" /><di:waypoint x="990" y="570" /><di:waypoint x="990" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1060" y="350" /><di:waypoint x="1150" y="350" /><di:waypoint x="1150" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1225" y="140" /><di:waypoint x="1275" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1325" y="140" /><di:waypoint x="1380" y="140" /><bpmndi:BPMNLabel><dc:Bounds x="1332" y="120" width="30" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1520" y="140" /><di:waypoint x="1620" y="140" /><di:waypoint x="1620" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1695" y="350" /><di:waypoint x="1752" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15"><di:waypoint x="1300" y="165" /><di:waypoint x="1300" y="530" /><bpmndi:BPMNLabel><dc:Bounds x="1306" y="420" width="110" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F16_di" bpmnElement="F16"><di:waypoint x="1375" y="570" /><di:waypoint x="1442" y="570" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DA_DO_base_di" bpmnElement="DA_DO_base"><di:waypoint x="260" y="390" /><di:waypoint x="260" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DA_DO_alerta_di" bpmnElement="DA_DO_alerta"><di:waypoint x="910" y="595" /><di:waypoint x="1022" y="595" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
