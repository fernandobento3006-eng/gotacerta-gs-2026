<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_asis" targetNamespace="http://fiap.com.br/gs2026/gotacerta" exporter="Equipe Gota Zero" exporterVersion="1.0">
  <bpmn:collaboration id="C_asis">
    <bpmn:participant id="Pool_asis" name="AS-IS: a família descobre o vazamento pela conta" processRef="P_asis" />
  </bpmn:collaboration>
  <bpmn:process id="P_asis" name="AS-IS: a família descobre o vazamento pela conta" isExecutable="false">
    <bpmn:laneSet id="LS_asis">
      <bpmn:lane id="L_fam" name="Família (cliente)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_sab" name="Sabesp (atendimento)">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Conta do mês chega">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Ler a conta de água">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:property id="T1_prop_DO_conta" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_DO_conta">
        <bpmn:sourceRef>DO_conta</bpmn:sourceRef>
        <bpmn:targetRef>T1_prop_DO_conta</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="Valor acima do normal?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T2" name="Pagar a conta">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Conta paga">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T3" name="Procurar o vazamento em casa, sem ajuda">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="Achou o vazamento?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Chamar encanador e consertar">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T6" name="Pagar a conta alta">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2" name="Conta alta paga">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T5" name="Reclamar na Sabesp (telefone ou agência)">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T7" name="Registrar a reclamação">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_DO_prot">
        <bpmn:targetRef>DO_prot</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T8" name="Fazer vistoria no imóvel (dias depois)">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="Vazamento na rede da Sabesp?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T9" name="Consertar a rede e revisar a conta">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E3" name="Conta revisada">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DO_conta" name="Conta de água" dataObjectRef="DO_DO_conta" />
    <bpmn:dataObject id="DO_DO_conta" />
    <bpmn:dataObjectReference id="DO_prot" name="Protocolo da reclamação" dataObjectRef="DO_DO_prot" />
    <bpmn:dataObject id="DO_DO_prot" />
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="Não" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="F4" name="" sourceRef="T2" targetRef="E1" />
    <bpmn:sequenceFlow id="F5" name="Sim" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F6" name="" sourceRef="T3" targetRef="G2" />
    <bpmn:sequenceFlow id="F7" name="Sim" sourceRef="G2" targetRef="T4" />
    <bpmn:sequenceFlow id="F8" name="" sourceRef="T4" targetRef="T6" />
    <bpmn:sequenceFlow id="F9" name="" sourceRef="T6" targetRef="E2" />
    <bpmn:sequenceFlow id="F10" name="Não" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F11" name="" sourceRef="T5" targetRef="T7" />
    <bpmn:sequenceFlow id="F12" name="" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F13" name="" sourceRef="T8" targetRef="G3" />
    <bpmn:sequenceFlow id="F14" name="Sim" sourceRef="G3" targetRef="T9" />
    <bpmn:sequenceFlow id="F15" name="" sourceRef="T9" targetRef="E3" />
    <bpmn:sequenceFlow id="F16" name="Não (vazamento dentro de casa)" sourceRef="G3" targetRef="T4" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_asis" name="AS-IS - como a família descobre o vazamento hoje">
    <bpmndi:BPMNPlane id="PL_asis" bpmnElement="C_asis">
      <bpmndi:BPMNShape id="Pool_asis_di" bpmnElement="Pool_asis" isHorizontal="true"><dc:Bounds x="40" y="40" width="1560" height="530" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_fam_di" bpmnElement="L_fam" isHorizontal="true"><dc:Bounds x="70" y="40" width="1530" height="300" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_sab_di" bpmnElement="L_sab" isHorizontal="true"><dc:Bounds x="70" y="340" width="1530" height="230" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="112" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="70" y="224" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="190" y="160" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="355" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="316" y="230" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="440" y="75" width="120" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="602" y="87" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="560" y="129" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="440" y="160" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="625" y="175" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="600" y="150" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="730" y="160" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="920" y="160" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="1092" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1050" y="224" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="725" y="260" width="150" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T7_di" bpmnElement="T7"><dc:Bounds x="895" y="400" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T8_di" bpmnElement="T8"><dc:Bounds x="1050" y="400" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G3_di" bpmnElement="G3" isMarkerVisible="true"><dc:Bounds x="1235" y="415" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1200" y="474" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T9_di" bpmnElement="T9"><dc:Bounds x="1330" y="400" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E3_di" bpmnElement="E3"><dc:Bounds x="1512" y="422" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1470" y="464" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_conta_di" bpmnElement="DO_conta"><dc:Bounds x="232" y="60" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="190" y="112" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_prot_di" bpmnElement="DO_prot"><dc:Bounds x="942" y="487" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="900" y="539" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="148" y="200" /><di:waypoint x="190" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="310" y="200" /><di:waypoint x="355" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="380" y="175" /><di:waypoint x="380" y="105" /><di:waypoint x="440" y="105" /><bpmndi:BPMNLabel><dc:Bounds x="388" y="120" width="30" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="560" y="105" /><di:waypoint x="602" y="105" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="405" y="200" /><di:waypoint x="440" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="408" y="180" width="30" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="580" y="200" /><di:waypoint x="625" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="675" y="200" /><di:waypoint x="730" y="200" /><bpmndi:BPMNLabel><dc:Bounds x="684" y="180" width="30" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="870" y="200" /><di:waypoint x="920" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1040" y="200" /><di:waypoint x="1092" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="650" y="225" /><di:waypoint x="650" y="290" /><di:waypoint x="725" y="290" /><bpmndi:BPMNLabel><dc:Bounds x="656" y="262" width="30" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="875" y="290" /><di:waypoint x="960" y="290" /><di:waypoint x="960" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1025" y="440" /><di:waypoint x="1050" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1190" y="440" /><di:waypoint x="1235" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1285" y="440" /><di:waypoint x="1330" y="440" /><bpmndi:BPMNLabel><dc:Bounds x="1290" y="420" width="30" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15"><di:waypoint x="1470" y="440" /><di:waypoint x="1512" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F16_di" bpmnElement="F16"><di:waypoint x="1260" y="415" /><di:waypoint x="1260" y="252" /><di:waypoint x="800" y="252" /><di:waypoint x="800" y="240" /><bpmndi:BPMNLabel><dc:Bounds x="1050" y="256" width="200" height="18" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DA_DO_conta_di" bpmnElement="DA_DO_conta"><di:waypoint x="250" y="110" /><di:waypoint x="250" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DA_DO_prot_di" bpmnElement="DA_DO_prot"><di:waypoint x="960" y="480" /><di:waypoint x="960" y="487" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
